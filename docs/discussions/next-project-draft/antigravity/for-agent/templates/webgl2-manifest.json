{
  "$schema": "https://grapel.org/schemas/environment-manifest.v1.json",
  "environment": "webgl2",
  "version": "WebGL 2.0 (OpenGL ES 3.0)",
  "supportedStages": [
    "vertex",
    "fragment"
  ],
  "supportedTypes": [
    "float",
    "int",
    "uint",
    "bool",
    "vec2",
    "vec3",
    "vec4",
    "ivec2",
    "ivec3",
    "ivec4",
    "uvec2",
    "uvec3",
    "uvec4",
    "bvec2",
    "bvec3",
    "bvec4",
    "mat2",
    "mat3",
    "mat4"
  ],
  "capabilities": [
    "glsl.expression"
  ]
}
