{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "lib": ["ES2019"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "removeComments": false,
    "rootDir": "src/core-ts",
    "outDir": "build/core"
  },
  "include": ["src/core-ts/**/*.ts"]
}
